<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include('../partials/head', {title: 'Formulario de creación' }) %>

	<body>
		<!-- Header -->
		<%- include('../partials/headerNavbar') %>
			<!-- /Header -->
			<!-- todos los productos -->
			<div class="container container-wrapper">
				<div class="row">
					<div class="col-12">
						<h2 class="products-title">Formulario de creación de productos</h2>
					</div>
				</div>
				<div class="col-12">
					<form action="/admin/crear-producto" method="post" enctype="multipart/form-data">
						<div class="row product-detail">
							<div class="col-12 col-md-6">
								<label for="name" class="form-label">Nombre del producto:</label>
								<input type="text" id="name" name="name" placeholder="Ej: Zapatillas Reebok" value="<%= locals.old?.name %>" 
									class="form-input <%= locals.errors?.name ? "input-invalid" : "input-valid" %>">
									<p class="msg-error"> <%= locals.errors?.name?.msg %></p>
							</div>
							<div class="col-12 col-md-6">
								<label for="price" class="form-label">Precio del producto:</label>
								<input type="text" id="price" name="price" placeholder="Ej: 5678" value="<%= locals.old?.price %>" 
								class="form-input <%= locals.errors?.price ? "input-invalid" : "input-valid" %>">
								<p class="msg-error"> <%= locals.errors?.price?.msg %></p>
							</div>
							<div class="col-12 col-md-6">
								<label for="discount" class="form-label">Descuento:</label>
								<input type="text" id="discount" name="discount" placeholder="Ej: 15" value="<%= locals.old?.discount %>"
									class="form-input  <%= locals.errors?.discount ? "input-invalid" : "input-valid" %>">
									<p class="msg-error"> <%= locals.errors?.discount?.msg %></p>
							</div>
							<div class="col-12 col-md-6">
								<label for="category" class="form-label">Categoría:</label>
								<select name="category" id="category" class="form-input <%= locals.errors?.category? "input-invalid" : "input-valid" %>">
									<option <%= locals.old?.category === "" ? "selected" : null %> value="" selected hidden>Elegí</option>
									<option <%= locals.old?.category === "in-sale" ? "selected" : null %> value="in-sale">En oferta</option>
									<option <%= locals.old?.category === "visited" ? "selected" : null %> value="visited">Últimos agregados</option>
								</select>
								<p class="msg-error"> <%= locals.errors?.category?.msg %></p>
							</div>
							<div class="col-12">
								<label for="description" class="form-label">Descripción:</label>
								<textarea name="description" id="description" class="form-input <%= locals.errors?.description ? "input-invalid" : "input-valid" %>"><%= locals.old?.description %></textarea>
								<p class="msg-error"> <%= locals.errors?.description?.msg %></p>
							</div>
							<div class="col-12 mb-5">
								<label for="imagen" class="form-label">Imagen del producto</label>
								<input class="form-control custom-file-input" name="img" type="file" id="imagen"
									accept="image/*">
									<p class="msg-error"> <%= locals.errors?.img?.msg %></p>
							</div>
							<!-- Botones-->
							<div
								class="col-12  d-flex flex-column flex-md-row justify-content-md-center justify-content-lg-end gap-md-3">
								<button type="submit" class="buy-now-button">REGISTRAR</button>
								<a href="/productos" class="buy-now-button cancel-button">CANCELAR</a>
							</div>
							<!-- /Botones-->
						</div>
					</form>
				</div>
			</div>
			<!-- /todos los productos -->

			<!-- footer -->
			<%- include('../partials/footer') %>
				<!-- /footer -->

				<!-- scripts -->
				<%- include("../partials/scripts") %>
					<!-- /scripts -->
	</body>

</html>